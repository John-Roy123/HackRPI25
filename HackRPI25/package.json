{
  "name": "hackrpi25",
  "version": "1.0.0",
  "description": "HackRPI25 - Phaser Game with Express Backend",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "vite",
    "dev:backend": "tsx watch server/index.ts",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node dist/server/index.js"
  },
  "dependencies": {
    "@google/genai": "^1.29.1",
    "@google/generative-ai": "^0.24.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "phaser": "^3.55.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.14",
    "@types/express": "^4.17.20",
    "@types/node": "^20.9.0",
    "concurrently": "^8.2.2",
    "tsx": "^4.0.0",
    "typescript": "^5.2.2",
    "vite": "^7.2.2"
  }
}
